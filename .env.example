# MeetAI - mẫu cấu hình. Copy thành `.env` (đã git-ignore) rồi sửa.
#
# Mọi giá trị dưới đây là MẶC ĐỊNH FAIL-CLOSED. Bỏ comment chỉ khi hiểu rõ hệ quả.
#
# Hai quy tắc vận hành cần biết trước:
#   1. Biến `MEETAI_*` không được nhận dạng sẽ làm app TỪ CHỐI KHỞI ĐỘNG.
#      Chống gõ sai tên: một biến consent/persistence gõ sai sẽ trông như đã bật
#      trong khi thực tế vẫn giữ mặc định. Hệ quả: mọi biến `MEETAI_*` mà code đọc
#      đều phải là một field trong `settings.py`, không được dùng `os.getenv`.
#   2. Bất kỳ biến `OTEL_*`, `HF_*`, `HUGGINGFACE*`, `TRANSFORMERS*` hoặc
#      `*_PROXY` nào TỒN TẠI cũng làm app TỪ CHỐI KHỞI ĐỘNG — theo SỰ HIỆN DIỆN,
#      không theo giá trị. Kể cả `HF_HUB_OFFLINE=1`, kể cả chuỗi rỗng: một guard
#      cho qua giá trị "an toàn" sẽ dạy bạn rằng biến đó có tác dụng ở đây, và
#      sẽ im lặng đúng ngày nó thành `0`.
#        - `OTEL_*` LÀ một đường gửi dữ liệu ra ngoài, thư viện đọc trực tiếp.
#        - `HF_*` / `HUGGINGFACE*` / `TRANSFORMERS*` quyết định WEIGHTS LẤY TỪ
#          ĐÂU (`HF_ENDPOINT` là một host, `HF_HOME` là một thư mục), nên chúng
#          biến được một thiết kế local-file thành một thiết kế tải về.
#        - `*_PROXY` ROUTE VÒNG QUA phép cô lập egress tầng OS.
#      `XDG_CACHE_HOME` cố ý KHÔNG bị chặn: nó chỉ đổi chỗ cache.
#      Nếu bạn cần một trong các biến này cho việc khác, bỏ nó khỏi môi trường
#      của phiên chạy MeetAI — đừng sửa guard.

# --- Local supervisor UI ---------------------------------------------------
# Chỉ cho phép loopback DẠNG SỐ. `localhost` cũng bị từ chối: đó là một cái tên,
# được phân giải lúc bind, nên một file hosts bị sửa sẽ đổi chỗ UI thực sự lắng nghe.
#MEETAI_UI_HOST=127.0.0.1
#MEETAI_UI_PORT=8765

# Nơi lưu state vận hành (KHÔNG chứa nội dung cuộc họp). Phải là ổ đĩa cục bộ:
# đường dẫn UNC hoặc ổ mạng bị từ chối, vì state sẽ rời khỏi máy một cách im lặng.
#MEETAI_STATE_DIR=var

# --- Consent (CHỜ QUYẾT ĐỊNH) ---------------------------------------------
# pending_decision | per_participant | host_coordinated
# Để `pending_decision` nghĩa là KHÔNG xử lý media. Đây là trạng thái đúng cho
# tới khi có lựa chọn (hồ sơ bàn giao mục 10 câu 1), không phải lỗi cấu hình.
#MEETAI_CONSENT_MODE=pending_decision

# pending_decision | a1_circuit_breaker | a3_admission_control
#MEETAI_LATE_JOIN_POLICY=pending_decision

# --- Lưu nội dung cuộc họp (CHỜ QUYẾT ĐỊNH, mặc định OFF) -----------------
# Không bật được khi `MEETAI_CONSENT_MODE` còn là `pending_decision`: ghi
# transcript trong khi khai báo "chưa chọn cách lấy consent" là tự mâu thuẫn.
#MEETAI_PERSIST_TRANSCRIPT=false
#MEETAI_PERSIST_NOTES=false
#MEETAI_PERSIST_REPLY_JOURNAL=false

# Debug raw audio là scope consent RIÊNG và cần xác nhận riêng bên dưới.
# Bật persist_transcript KHÔNG mở scope này.
#MEETAI_PERSIST_RAW_AUDIO_DEBUG=false
#MEETAI_RAW_AUDIO_DEBUG_ACKNOWLEDGED=false

# --- Tripwire: đặt true sẽ bị TỪ CHỐI, không phải được bật ----------------
# Hai biến này không phải công tắc tính năng. Chúng tồn tại để một cấu hình sai
# bị bắt ồn ào thay vì bị bỏ qua im lặng.
#MEETAI_REQUESTED_EXTERNAL_AI=false
#MEETAI_REQUESTED_LIVE_DISCORD_VOICE=false

# --- Credentials (chưa dùng ở Phase 0/1) ----------------------------------
# Không commit file `.env`. Giá trị không bao giờ được in ra log, UI hay thông
# báo lỗi: chỉ hiện "đã cấu hình" / "chưa có".
#MEETAI_DISCORD_BOT_TOKEN=
#MEETAI_GOOGLE_OAUTH_CLIENT_SECRET=
